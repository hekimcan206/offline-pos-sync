{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Sync": {
    "MaxClockDrift": "00:05:00",
    "MaxPushBatch": 500,
    "MaxPullLimit": 1000,
    "AdminKey": ""
  },
  "OpenApi": {
    "Enabled": false
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
