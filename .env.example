# Copy to .env to override the development defaults used by docker-compose.yml. Never commit .env.
POSTGRES_PASSWORD=postgres-dev-only
MIGRATOR_PASSWORD=migrator-dev-only
APP_PASSWORD=app-dev-only
# Protects /api/v1/admin (device registration, menu, read models). Use a long random value outside local demos.
ADMIN_KEY=admin-dev-only
POSTGRES_PORT=58632
SERVER_PORT=58280
# Demo timing (seconds)
ONLINE_SECONDS=6
PARTITION_SECONDS=10
FLAP_SECONDS=4
# Optional: send traces and metrics to an OTLP collector, e.g. the Aspire dashboard profile.
OTEL_EXPORTER_OTLP_ENDPOINT=
